# Local/default OpenAI-compatible model endpoint.
HELIS_LLM_BASE_URL=http://localhost:11434/v1
HELIS_LLM_MODEL=qwen3.5:9b
HELIS_LLM_API_KEY=
HELIS_LLM_INPUT_COST_PER_M=0
HELIS_LLM_OUTPUT_COST_PER_M=0

# First-party live adapters. Leave every secret empty until its operator-owned account is ready.
# Vercel publishes only an already-reviewed, explicitly approved preview artifact.
# HELIS_VERCEL_TOKEN=
# HELIS_VERCEL_ORG_ID=
# HELIS_VERCEL_PROJECT_ID=
# HELIS_VERCEL_CLI=vercel

# Brave Search performs read-only public B2B prospect discovery.
# HELIS_BRAVE_SEARCH_API_KEY=
# HELIS_BRAVE_COUNTRY=PL
# HELIS_BRAVE_SEARCH_LANG=pl

# Resend sends only an already-approved first contact and can read replies for that exact run.
# HELIS_RESEND_API_KEY=
# HELIS_RESEND_FROM="HELIS <hello@your-domain.example>"
# HELIS_RESEND_INBOUND_DOMAIN=your-inbound.resend.app

# Stripe creates only an already-approved exact-price Payment Link and polls observed payments.
# HELIS_STRIPE_SECRET_KEY=

# Optional approved validation gateway.
# HELIS_VALIDATION_GATEWAY_URL=https://gateway.example/helis/validation
# HELIS_VALIDATION_GATEWAY_TOKEN=

# Optional generic preview fallback when the direct Vercel adapter is not configured.
# HELIS_PREVIEW_GATEWAY_URL=https://gateway.example/helis/preview
# HELIS_PREVIEW_GATEWAY_TOKEN=

# Optional read-only prospect discovery gateway.
# HELIS_PROSPECT_GATEWAY_URL=https://gateway.example/helis/prospects
# HELIS_PROSPECT_GATEWAY_TOKEN=

# Optional approved first-contact gateway.
# HELIS_CONTACT_GATEWAY_URL=https://gateway.example/helis/contact
# HELIS_CONTACT_GATEWAY_TOKEN=

# Optional generic observed-contact-result fallback.
# HELIS_CONTACT_RESULT_GATEWAY_URL=https://gateway.example/helis/contact-result
# HELIS_CONTACT_RESULT_GATEWAY_TOKEN=

# Optional generic checkout/payment-observation fallback.
# HELIS_COMMERCE_GATEWAY_URL=https://gateway.example/helis/commerce
# HELIS_COMMERCE_GATEWAY_TOKEN=

# Controlled self-improvement boundaries. Keep these as separate operator-owned services/credentials.
# Evaluation compares an isolated candidate against its exact baseline.
# HELIS_SELF_EVAL_GATEWAY_URL=https://gateway.example/helis/self-eval
# HELIS_SELF_EVAL_GATEWAY_TOKEN=
# Review-branch materialization writes only the approved candidate to its deterministic review branch.
# HELIS_SELF_BRANCH_GATEWAY_URL=https://gateway.example/helis/self-branch
# HELIS_SELF_BRANCH_GATEWAY_TOKEN=
# CI is read-only and must freshly attest the exact review-branch head, files, Ruff and pytest.
# HELIS_SELF_CI_GATEWAY_URL=https://gateway.example/helis/self-ci
# HELIS_SELF_CI_GATEWAY_TOKEN=
# Final merge is a separate second-approved boundary and must reject a stale default-branch head.
# HELIS_SELF_MERGE_GATEWAY_URL=https://gateway.example/helis/self-merge
# HELIS_SELF_MERGE_GATEWAY_TOKEN=

# Local HTTP gateway development requires the corresponding explicit opt-in.
# HELIS_ALLOW_INSECURE_LOCAL_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_PREVIEW_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_PROSPECT_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_CONTACT_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_CONTACT_RESULT_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_COMMERCE_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_SELF_EVAL_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_SELF_BRANCH_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_SELF_CI_GATEWAY=1
# HELIS_ALLOW_INSECURE_LOCAL_SELF_MERGE_GATEWAY=1
