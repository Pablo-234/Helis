# Invoke every five minutes; HELIS itself enforces the 15-minute minimum wake interval
# plus its scheduler lease, so overlapping/too-frequent host invocations are safe.
*/5 * * * * cd "$HOME/Helis" && "$HOME/Helis/.venv/bin/helis-scheduler" wake --db "$HOME/Helis/helis.db" --workspace-root "$HOME/Helis/.helis/workspaces" --minimum-interval-seconds 900 --lease-seconds 600 --max-advances 2 >> "$HOME/Helis/.helis/scheduler.log" 2>&1
